DATABASE_URL="file:./dev.db"

# Image provider: "replicate" (default) | "fal" (stub) | "mock" (no key needed —
# returns the depth render as the artwork, for offline dev).
# If "replicate" is selected but no token is set, INVRT falls back to "mock".
IMAGE_PROVIDER="replicate"

# Get a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=""

# Override the Replicate model slug if Flux Depth moves/renames.
# REPLICATE_MODEL="black-forest-labs/flux-depth-dev"

FAL_KEY=""

# ANTHROPIC_API_KEY=""   # optional, only if enabling the /api/interpret stretch
